---
// src/layouts/Layout.astro
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import SideNav from "@components/SideNav.astro";
import SideBanner from "@components/SideBanner.astro";
import { ANALYTICS, SITE } from "@constants/index.ts";
import { isPreviewBuild } from "@libs/env.ts";
import "@styles/global.css";

interface Props {
  Meta: {
    title: string;
    description?: string | null;
    image?: string | URL | null;
    ogType?: string;
    noindex?: boolean | null;
  };
  // true のページは main の左右の余白を付けない（背景の帯を表示領域の幅いっぱいに敷くページ用。余白はページ側で付ける）
  bleed?: boolean;
  // true のページは PC 幅の左右（キャッチコピー・カテゴリ・バナー）を出さない（運営者情報・プライバシーポリシーなどの格式ばったページ用）
  plain?: boolean;
}

const siteTitle = SITE.title;
const siteDescription = SITE.description;
// canonical は常に本番のドメイン（astro.config.mjs の site）。プレビューや workers.dev で開いても変わらない
const url = new URL(Astro.url.pathname, Astro.site);
const isHome = Astro.url.pathname === "/";
const { Meta, bleed = false, plain = false } = Astro.props;
const pageTitle = isHome ? siteTitle : `${Meta.title} | ${siteTitle}`;
const pageDescription = Meta.description ? Meta.description : siteDescription;
const ogImage = new URL(Meta.image ? Meta.image : "/images/og.png", Astro.site);
const ogType = Meta.ogType ? Meta.ogType : "website";
// SITE.noindex は全ページ、Meta.noindex はそのページだけ、isPreviewBuild はプレビューのビルド（docs/site.md の「プレビュー」）
const noindex = SITE.noindex || Meta.noindex || isPreviewBuild;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    {
      /* アイコン（docs/design.md の「画像・アイコン」）。iPhone は SVG を使わないため、ホーム画面用に PNG も置く */
    }
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    {/* テーマの色（background の白。CSS の変数は使えないため値を直接書く） */}
    <meta name="theme-color" content="#ffffff" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@100..900&display=swap"
      rel="stylesheet"
    />
    <!-- OG settings -->
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={url} />
    <meta property="og:type" content={ogType} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="canonical" href={url} />
    {
      /*
      Google アナリティクス 4（docs/site.md の「アクセス解析」）。
      本番のドメイン（astro.config.mjs の site）で開いたときだけ計測する（手元の確認や workers.dev のアクセスを混ぜないため）
    */
    }
    <script
      is:inline
      define:vars={{
        measurementId: ANALYTICS.ga4MeasurementId,
        productionHost: Astro.site?.hostname ?? "",
      }}
    >
      // 測定ID が空のあいだは計測しない
      if (measurementId && location.hostname === productionHost) {
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () {
          window.dataLayer.push(arguments);
        };
        window.gtag("js", new Date());
        window.gtag("config", measurementId);
        const script = document.createElement("script");
        script.async = true;
        script.src =
          "https://www.googletagmanager.com/gtag/js?id=" + measurementId;
        document.head.appendChild(script);
      }
    </script>
    {
      /* ページごとに head へ足すもの（例: 記事ページの構造化データ）。<Fragment slot="head"> で渡す */
    }
    <slot name="head" />
  </head>
  <body>
    {
      /*
        ヘッダー・フッターは画面幅いっぱい。その間は、どの画面幅でもスマホの画面幅の表示領域（max-w-app）を中央に置く（docs/design.md の「レイアウト」）
        左右の余った幅は薄いグレーの背景（bg-outside）。境目は影（shadow-app）。PC 幅（lg 以上）では左にキャッチコピーとカテゴリ、右にバナーを置く（plain のページは置かない）
      */
    }
    <Header />
    <div class="lg:grid lg:grid-cols-[1fr_var(--container-app)_1fr]">
      <aside class="hidden lg:block">
        <div
          class="sticky top-16 flex h-[calc(100vh-4rem)] items-center justify-center px-10"
        >
          {!plain && <SideNav />}
        </div>
      </aside>
      <main
        class:list={[
          "mx-auto min-h-[calc(100vh-3.5rem)] w-full max-w-app bg-background lg:min-h-[calc(100vh-4rem)] lg:shadow-app",
          bleed ? "" : "px-5 pt-5 pb-14",
        ]}
      >
        <slot />
      </main>
      <aside class="hidden lg:block">
        <div
          class="sticky top-16 flex h-[calc(100vh-4rem)] items-center justify-center px-10"
        >
          {!plain && <SideBanner />}
        </div>
      </aside>
    </div>
    <Footer />
  </body>
</html>
