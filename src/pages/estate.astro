---
// ハブページ: 不動産投資（見出し・導入文は旧サイトの /estate/ をもとにしている）
import HubPage from "@components/HubPage.astro";
export const prerender = true;
---

<HubPage
  id="estate"
  heading="【あなたの未来を変える】不動産投資の基本から実践までを徹底解説"
  headingMarker="基本から実践まで"
  listHeading="ゼロから学ぶ！不動産投資の基礎と実践の記事"
  description="不動産投資のしくみ、始め方、リスクを抑える方法や、不動産クラウドファンディングの比較を、難しい言葉を使わずに解説しています。"
  points={[
    {
      title: "家賃収入で、安定した収益をめざせる",
      text: "株のように毎日値段が大きく動くことが少なく、家賃という形で収益を受け取れるのが特徴です。",
    },
    {
      title: "クラウドファンディングなら1万円から",
      text: "不動産クラウドファンディングでは、1つの物件にたくさんの人がお金を出し合うため、1万円前後から投資できるものが多くあります。",
    },
    {
      title: "運用期間や条件をよく比べる",
      text: "サービスによって、運用期間・利回り・元本を守る仕組みが違います。申し込む前に比べておきましょう。",
    },
  ]}
  steps={[
    {
      title: "サービスを比べる",
      text: "物件の種類、運用期間、元本を守る仕組みなどを比べて、自分に合うサービスを選びます。",
    },
    {
      title: "会員登録をする",
      text: "スマホで申し込めます。本人確認書類を用意しましょう。",
    },
    {
      title: "ファンドに申し込む",
      text: "人気のファンドは抽選や先着順になることがあります。募集の日時を確認しておきましょう。",
    },
    {
      title: "分配金を受け取る",
      text: "運用中は分配金を受け取り、運用が終わると出資したお金が戻ります。",
    },
  ]}
  faqs={[
    {
      question: "不動産投資は大きなお金が必要ですか？",
      answer:
        "物件を自分で買う場合はまとまったお金やローンが必要です。不動産クラウドファンディングなら、少ない金額から始められます。",
    },
    {
      question: "元本が減ることはありますか？",
      answer:
        "あります。物件の価格が下がったり、空室が続いたりすると、元本が減ることがあります。元本を守る仕組みの有無も確認しましょう。",
    },
    {
      question: "途中でやめられますか？",
      answer:
        "多くのファンドは、運用期間の途中で解約できないか、条件があります。使う予定のないお金で申し込みましょう。",
    },
  ]}
>
  <p>
    家賃収入や資産づくりに興味はあるけれど、不動産投資は難しそう。そんな方に向けて、不動産投資のしくみ、具体的な始め方、リスクを抑える方法を、難しい言葉をなるべく使わずにまとめました。
  </p>
  <p>
    少額から始められる不動産クラウドファンディングの比較や、物件選びのコツも紹介しています。
  </p>
</HubPage>
