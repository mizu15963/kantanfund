---
// ハブページ: 株式投資（見出し・導入文は旧サイトの /stock/ をもとにしている）
import HubPage from "@components/HubPage.astro";
export const prerender = true;
---

<HubPage
  id="stock"
  heading="【焦らなくて大丈夫】「投資って何？」から始める安心の資産運用ガイド"
  headingMarker="安心の資産運用ガイド"
  listHeading="難しいは卒業！株式・投資信託の基本を学ぶ記事"
  description="株式投資の始め方や、少額から専門家に運用を任せられる投資信託のしくみを、はじめての方向けに解説した記事をまとめています。"
  points={[
    {
      title: "少ないお金から始められる",
      text: "投資信託なら月100円から、株も1株単位で買える「単元未満株」のサービスがあり、まとまったお金がなくても始められます。",
    },
    {
      title: "NISA なら利益に税金がかからない",
      text: "ふつうは利益に約20%の税金がかかりますが、NISA の口座で買った分の利益には税金がかかりません。",
    },
    {
      title: "長く・分けて持つとリスクを抑えやすい",
      text: "買う時期や銘柄を分けて、長い期間持ち続けることで、値動きの影響をならしやすくなります。",
    },
  ]}
  steps={[
    {
      title: "証券口座を開く",
      text: "ネット証券ならスマホで申し込めます。本人確認書類とマイナンバーを用意しましょう。",
    },
    {
      title: "NISA の口座も一緒に作る",
      text: "口座を開くときに NISA の口座も申し込むと、手間が少なく済みます。",
    },
    {
      title: "入金して、買うものを選ぶ",
      text: "はじめは投資信託の積立がおすすめされることが多いです。金額は無理のない範囲で決めます。",
    },
    {
      title: "ときどき見直す",
      text: "毎日値動きを気にする必要はありません。年に1〜2回、配分や積立額を見直しましょう。",
    },
  ]}
  faqs={[
    {
      question: "いくらあれば始められますか？",
      answer:
        "投資信託の積立なら、証券会社によっては月100円から始められます。生活費とは別の、当面使わないお金で始めましょう。",
    },
    {
      question: "株と投資信託はどう違いますか？",
      answer:
        "株は1つの会社に投資し、投資信託はたくさんの会社などにまとめて投資します。投資信託は運用を専門家に任せられるので、はじめての方でも選びやすいです。",
    },
    {
      question: "元本が減ることはありますか？",
      answer:
        "あります。株や投資信託は値動きがあり、買ったときより値下がりすることもあります。余裕のあるお金で、長く続けることが大切です。",
    },
  ]}
>
  <p>
    株式投資の始め方や、少額から専門家に運用を任せられる投資信託のしくみを、はじめての方向けに解説した記事をまとめました。
  </p>
  <p>NISA のことや証券会社の選び方も、自分のペースで読み進めてください。</p>
</HubPage>
