---
// プライバシーポリシー（仕様: docs/site.md の「プライバシーポリシー」）
// 旧サイトにはなかったページ。文面は参考プロジェクトの /privacy-policy をもとに、広告（アフィリエイト）の項目を足している
import Layout from "@layouts/Layout.astro";
import PageHeader from "@components/PageHeader.astro";
import Breadcrumb from "@components/Breadcrumb.astro";
import { SITE } from "@constants/index.ts";
export const prerender = true;

const Meta = {
  title: "プライバシーポリシー",
  description: `${SITE.title}のプライバシーポリシー（個人情報保護方針）です。`,
};

// 制定日（内容を変えたら改定日を足す）
const establishedAt = "2026年10月25日";

// links の external: true は外部サイト（別タブで開く）
type SectionLink = { href: string; label: string; external?: boolean };
const sections: {
  title: string;
  text?: string;
  items?: string[];
  links?: SectionLink[];
}[] = [
  {
    title: "個人情報の利用目的",
    text: "当サイトでは、お問い合わせフォームからのご連絡の際に、お名前（ハンドルネームを含む）やメールアドレスなどの個人情報をお預かりします。お預かりした個人情報は、次の目的で利用します。",
    items: [
      "お問い合わせへの回答や、必要なご連絡を電子メールなどでお送りするため",
      "当サイトの改善や、掲載内容の充実の参考にするため",
      "上記の目的に付随する業務のため",
    ],
  },
  {
    title: "個人情報の管理",
    text: "お預かりした個人情報は正確な状態に保ち、不正アクセス・紛失・破損・改ざん・漏えいなどを防ぐため、適切な安全対策を行って管理します。お問い合わせの内容は、当サイトが利用するコンテンツ管理サービス（株式会社microCMS の「microCMS」）に保存します。",
  },
  {
    title: "第三者への提供",
    text: "次の場合を除き、ご本人の同意なく個人情報を第三者に提供することはありません。",
    items: [
      "ご本人の同意がある場合",
      "法令にもとづいて開示が必要な場合",
      "人の生命・身体・財産を守るために必要で、ご本人の同意を得ることが難しい場合",
    ],
  },
  {
    title: "個人情報の開示・訂正・削除など",
    text: "ご本人から、個人情報の開示・訂正・追加・削除・利用停止などのご希望があった場合は、ご本人であることを確認したうえで、速やかに対応します。ご請求は、下記のお問い合わせ窓口からお願いします。",
  },
  {
    title: "アクセス解析ツールについて",
    text: "当サイトでは、サイトの利用状況を把握して改善に役立てるため、Google LLC が提供するアクセス解析ツール「Google アナリティクス」を利用しています。Google アナリティクスは、Cookie を使ってアクセスに関する情報（閲覧したページ、利用している端末やブラウザの種類、おおよその地域など）を集めます。集めた情報に、お名前やメールアドレスなど、個人を特定する情報は含まれません。",
    items: [
      "集めた情報は、Google のプライバシーポリシーにもとづいて管理されます。",
      "ブラウザの設定で Cookie を無効にするか、Google が提供するオプトアウト アドオンを使うと、情報の収集を止めることができます。",
    ],
    links: [
      {
        href: "https://policies.google.com/technologies/partner-sites?hl=ja",
        label:
          "Google のサービスを使用するサイトやアプリから収集した情報の Google による使用",
        external: true,
      },
      {
        href: "https://tools.google.com/dlpage/gaoptout?hl=ja",
        label: "Google アナリティクス オプトアウト アドオン",
        external: true,
      },
    ],
  },
  {
    title: "広告（アフィリエイトプログラム）について",
    text: "当サイトは、証券会社や投資サービスなどを紹介するアフィリエイトプログラムに参加しています。記事内のリンクから商品・サービスのお申し込みなどがあった場合、当サイトが紹介料を受け取ることがあります。広告を含む記事には、その旨を記事の先頭に表示しています。",
    items: [
      "広告の配信事業者や広告主は、広告の成果を確かめるために Cookie を使うことがあります。Cookie で集める情報に、お名前やメールアドレスなど、個人を特定する情報は含まれません。",
      "商品・サービスのお申し込みの際に入力する情報は、各社の個人情報の取り扱いにしたがって管理されます。当サイトがその情報を受け取ることはありません。",
    ],
  },
  {
    title: "このポリシーの変更",
    text: "法令の改正や運営方針の変更などにあわせて、このポリシーの内容を見直し、改善に努めます。変更後のプライバシーポリシーは、このページでお知らせします。",
  },
  {
    title: "お問い合わせ窓口",
    // お問い合わせのページを作ったら links にフォームへのリンクを足す（docs/todo.md）
    text: `個人情報の開示・訂正・削除などに関するお問い合わせは、お問い合わせフォームからご連絡ください。（運営者: ${SITE.title} 代表 伊藤 颯汰）`,
    links: [{ href: "/operator/", label: "運営者情報" }],
  },
];
---

<Layout Meta={Meta}>
  <div class="space-y-8">
    <div class="space-y-5">
      <Breadcrumb
        items={[{ name: "TOP", url: "/" }, { name: "プライバシーポリシー" }]}
      />
      <PageHeader title="プライバシーポリシー">
        <p class="mt-4 text-sm leading-relaxed text-muted-foreground">
          「{SITE.title}」（以下「当サイト」）は、お預かりした個人情報を、以下のプライバシーポリシー（個人情報保護方針）にしたがって適切に取り扱います。
        </p>
      </PageHeader>
    </div>

    {/* 各項目: 水色の丸に番号＋見出し、区切り線で区切る */}
    <div class="border-t-2 border-primary">
      {
        sections.map((section, index) => (
          <section class="border-b border-line py-6">
            <h2 class="flex items-start gap-3 text-lg leading-snug font-black">
              <span
                class="mt-0.5 flex size-7 shrink-0 items-center justify-center rounded-full bg-highlight text-xs text-highlight-foreground tabular-nums"
                aria-hidden="true"
              >
                {index + 1}
              </span>
              {section.title}
            </h2>
            <div class="mt-3 space-y-3 text-[0.95rem] leading-loose">
              {section.text && <p>{section.text}</p>}
              {section.items && (
                <ul class="list-disc space-y-2 pl-5 text-sm leading-relaxed">
                  {section.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              )}
              {section.links?.map((link) => (
                <p class="text-sm">
                  <a
                    href={link.href}
                    class="font-bold break-all underline hover:text-link-hover"
                    {...(link.external
                      ? { target: "_blank", rel: "noopener" }
                      : {})}
                  >
                    {link.label}
                  </a>
                </p>
              ))}
            </div>
          </section>
        ))
      }
    </div>

    <p class="text-right text-sm text-muted-foreground">
      制定日: {establishedAt}
    </p>
  </div>
</Layout>
