---
// お問い合わせフォーム（仕様: docs/contact.md）
// サイトで唯一のアクセス時に作るページ。送信もこのページが受け取り、成功したら完了ページへ移動する
// （microCMS に書き込むキーをブラウザに出さないため、保存はサーバー側で行う）
import Layout from "@layouts/Layout.astro";
import PageHeader from "@components/PageHeader.astro";
import Breadcrumb from "@components/Breadcrumb.astro";
import { CONTACT, SITE } from "@constants/index.ts";
import {
  contactAvailable,
  contactLabel,
  contactSelectOptions,
  emailFormatMessage,
  readContactForm,
  saveContact,
  turnstileSiteKey,
  validateContact,
  verifyTurnstile,
  type ContactErrors,
  type ContactInput,
} from "@libs/contact.ts";
export const prerender = false;

// workers.dev のアドレスは検索エンジンに載せない（静的なページは public/_headers で付けるが、このページには届かないためここで付ける。docs/site.md の「プレビュー」）
if (Astro.url.hostname.endsWith(".workers.dev")) {
  Astro.response.headers.set("X-Robots-Tag", "noindex");
}

const available = contactAvailable();
let input: ContactInput = {
  name: "",
  email: "",
  category: "",
  message: "",
  agree: false,
};
let errors: ContactErrors = {};

if (Astro.request.method === "POST" && available) {
  const form = await Astro.request.formData();
  input = readContactForm(form);

  // 人には見えない入力欄（website）に値が入っていたら自動送信とみなし、保存せず完了ページへ
  if (String(form.get("website") ?? "") !== "") {
    return Astro.redirect(CONTACT.thanksPath, 303);
  }

  errors = validateContact(input);
  if (Object.keys(errors).length === 0) {
    const token = String(form.get("cf-turnstile-response") ?? "");
    const ip = Astro.request.headers.get("CF-Connecting-IP");
    try {
      if (!(await verifyTurnstile(token, ip))) {
        errors.form =
          "送信を確認できませんでした。お手数ですが、もう一度送信してください。";
      } else {
        await saveContact(input);
        return Astro.redirect(CONTACT.thanksPath, 303);
      }
    } catch (error) {
      // Turnstile の確認や microCMS への保存の通信に失敗したとき
      console.error("[contact] お問い合わせの受け付けに失敗しました", error);
      errors.form =
        "送信に失敗しました。時間をおいて、もう一度お試しください。";
    }
  }
  if (Object.keys(errors).length > 0) Astro.response.status = 400;
}

const categories = contactSelectOptions("category");

const Meta = {
  title: "お問い合わせ",
  description: `${SITE.title}へのご意見・ご質問・お問い合わせはこちらから。`,
};

// 入力欄の共通の見た目（スマホで拡大されないよう文字は 16px）。エラーのときは黒の太枠
const fieldClass =
  "mt-2 block w-full rounded-box border-2 bg-background px-3 py-2.5 text-base focus:border-primary focus:outline-none";
const borderClass = (error?: string) =>
  error ? "border-primary" : "border-line";
---

<Layout Meta={Meta} plain>
  <div class="space-y-8">
    <div class="space-y-5">
      <Breadcrumb
        items={[{ name: "TOP", url: "/" }, { name: "お問い合わせ" }]}
      />
      <PageHeader title="お問い合わせ">
        <p class="mt-4 text-sm leading-relaxed text-muted-foreground">
          {
            SITE.title
          }へのご意見・ご質問・記事の掲載についてのご相談などを受け付けています。内容を確認のうえ、必要に応じてご入力のメールアドレスにご連絡します。
        </p>
        <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
          運営者は金融商品取引業者ではないため、個別の銘柄の売買や資産運用のご相談にはお答えできません。ご入力いただいた個人情報は、<a
            href="/privacy-policy/"
            class="font-bold text-link underline hover:text-link-hover"
            >プライバシーポリシー</a
          >にもとづいて適切に取り扱います。
        </p>
      </PageHeader>
    </div>

    {
      !available ? (
        <p class="rounded-box border-2 border-primary px-4 py-4 text-sm leading-relaxed">
          お問い合わせフォームは現在準備中です。準備ができ次第、このページから送信できるようになります。
        </p>
      ) : (
        <form id="contact-form" method="post" class="space-y-7" novalidate>
          {errors.form && (
            <p
              class="rounded-box border-2 border-primary bg-highlight px-4 py-3 text-sm font-bold text-highlight-foreground"
              role="alert"
            >
              {errors.form}
            </p>
          )}

          {/* 自動送信よけ（人には見えない入力欄。値が入っていたら保存しない） */}
          <div class="hidden" aria-hidden="true">
            <label>
              website
              <input
                type="text"
                name="website"
                tabindex="-1"
                autocomplete="off"
              />
            </label>
          </div>

          <div>
            <label for="contact-name" class="flex items-center gap-2 font-bold">
              {contactLabel("name")}
              <span class="rounded-full bg-highlight px-2 py-0.5 text-[10px] font-bold text-highlight-foreground">
                必須
              </span>
            </label>
            <input
              id="contact-name"
              type="text"
              name="name"
              value={input.name}
              maxlength={CONTACT.maxLength.name}
              autocomplete="name"
              placeholder="ニックネームでもかまいません"
              required
              aria-invalid={errors.name ? "true" : undefined}
              aria-describedby={errors.name ? "contact-name-error" : undefined}
              class:list={[fieldClass, borderClass(errors.name)]}
            />
            {errors.name && (
              <p id="contact-name-error" class="mt-1.5 text-sm font-bold">
                ※ {errors.name}
              </p>
            )}
          </div>

          <div>
            <label
              for="contact-email"
              class="flex items-center gap-2 font-bold"
            >
              {contactLabel("email")}
              <span class="rounded-full bg-highlight px-2 py-0.5 text-[10px] font-bold text-highlight-foreground">
                必須
              </span>
            </label>
            <input
              id="contact-email"
              type="email"
              name="email"
              value={input.email}
              maxlength={CONTACT.maxLength.email}
              autocomplete="email"
              inputmode="email"
              required
              aria-invalid={errors.email ? "true" : undefined}
              aria-describedby="contact-email-error"
              data-pattern={CONTACT.emailPattern}
              class:list={[fieldClass, borderClass(errors.email)]}
            />
            {/* エラー文の欄は常に置き、画面側の形式チェックでも使う */}
            <p
              id="contact-email-error"
              class="mt-1.5 text-sm font-bold"
              data-format-message={`※ ${emailFormatMessage}`}
              hidden={!errors.email}
            >
              {errors.email && `※ ${errors.email}`}
            </p>
          </div>

          <fieldset
            aria-describedby={
              errors.category ? "contact-category-error" : undefined
            }
          >
            <legend class="flex items-center gap-2 font-bold">
              {contactLabel("category")}
              <span class="rounded-full bg-highlight px-2 py-0.5 text-[10px] font-bold text-highlight-foreground">
                必須
              </span>
            </legend>
            <div class="mt-2 space-y-1">
              {categories.map((category) => (
                <label class="flex min-h-11 cursor-pointer items-center gap-3">
                  <input
                    type="radio"
                    name="category"
                    value={category}
                    checked={input.category === category}
                    required
                    class="size-5 shrink-0 accent-primary"
                  />
                  {category}
                </label>
              ))}
            </div>
            {errors.category && (
              <p id="contact-category-error" class="mt-1.5 text-sm font-bold">
                ※ {errors.category}
              </p>
            )}
          </fieldset>

          <div>
            <label
              for="contact-message"
              class="flex items-center gap-2 font-bold"
            >
              {contactLabel("message")}
              <span class="rounded-full bg-highlight px-2 py-0.5 text-[10px] font-bold text-highlight-foreground">
                必須
              </span>
            </label>
            <textarea
              id="contact-message"
              name="message"
              rows="8"
              maxlength={CONTACT.maxLength.message}
              required
              aria-invalid={errors.message ? "true" : undefined}
              aria-describedby={
                errors.message ? "contact-message-error" : undefined
              }
              class:list={[
                fieldClass,
                "leading-relaxed",
                borderClass(errors.message),
              ]}
            >
              {input.message}
            </textarea>
            {errors.message && (
              <p id="contact-message-error" class="mt-1.5 text-sm font-bold">
                ※ {errors.message}
              </p>
            )}
          </div>

          <div class="border-t border-line pt-6">
            <label class="flex min-h-11 cursor-pointer items-center gap-3">
              <input
                type="checkbox"
                name="agree"
                checked={input.agree}
                required
                aria-describedby={
                  errors.agree ? "contact-agree-error" : undefined
                }
                class="size-5 shrink-0 accent-primary"
              />
              <span>
                <a
                  href="/privacy-policy/"
                  target="_blank"
                  rel="noopener"
                  class="font-bold text-link underline hover:text-link-hover"
                >
                  プライバシーポリシー
                </a>
                に同意する
              </span>
            </label>
            {errors.agree && (
              <p id="contact-agree-error" class="mt-1.5 text-sm font-bold">
                ※ {errors.agree}
              </p>
            )}
          </div>

          {/* Turnstile（自動送信よけ）。多くの場合は操作不要で自動的に確認される */}
          <div
            class="cf-turnstile"
            data-sitekey={turnstileSiteKey()}
            data-language="ja"
            data-callback="onContactTurnstile"
            data-expired-callback="onContactTurnstileExpired"
            data-error-callback="onContactTurnstileExpired"
          />

          <div>
            <button
              id="contact-submit"
              type="submit"
              class="w-full rounded-button border-2 border-primary bg-highlight px-7 py-3.5 font-bold text-highlight-foreground hover:bg-highlight-hover disabled:cursor-not-allowed disabled:border-line disabled:bg-section disabled:text-muted-foreground"
            >
              送信する
            </button>
            <p
              id="contact-submit-hint"
              class="mt-2 text-xs leading-relaxed text-muted-foreground"
              hidden
            >
              必須項目をすべて正しく入力し、プライバシーポリシーに同意すると送信できます。
            </p>
          </div>
        </form>
      )
    }
  </div>
</Layout>

{
  /* 以下のスクリプトはフォームがあるときだけ動く（準備中の表示のときは何もしない） */
}
{
  /* Turnstile の通常の表示は幅 300px で、360px 未満の画面ではみ出すため、小さい表示（compact）にする */
}
<script is:inline>
  if (window.innerWidth < 360) {
    document
      .querySelector(".cf-turnstile")
      ?.setAttribute("data-size", "compact");
  }
</script>
{
  /*
  送信ボタンは、必須項目の入力・メールアドレスの形式・同意・Turnstile の確認がそろうまで押せないようにする（使う人のための補助）。
  押した後は「送信中…」にして二重送信を防ぐ。JavaScript が動かない場合はボタンを押せるままにし、サーバー側のチェックに任せる
*/
}
<script is:inline>
  (() => {
    const form = document.getElementById("contact-form");
    const button = document.getElementById("contact-submit");
    const hint = document.getElementById("contact-submit-hint");
    if (!form || !button) return;
    let verified = false;
    let sending = false;
    // メールアドレスの形式（サーバー側と同じ決まり。CONTACT.emailPattern）
    const email = form.elements.email;
    const emailError = document.getElementById("contact-email-error");
    const emailPattern = new RegExp(email.dataset.pattern);
    const emailValid = () => emailPattern.test(email.value.trim());
    // 形式のエラー文は、入力欄から離れたとき（入力途中では出さない）と、表示中に直したときに切り替える
    const showEmailError = (show) => {
      if (!emailError) return;
      if (show) emailError.textContent = emailError.dataset.formatMessage;
      emailError.hidden = !show;
      email.setAttribute("aria-invalid", show ? "true" : "false");
      email.classList.toggle("border-primary", show);
      email.classList.toggle("border-line", !show);
    };
    email.addEventListener("blur", () =>
      showEmailError(email.value.trim() !== "" && !emailValid())
    );
    email.addEventListener("input", () => {
      if (emailError && !emailError.hidden && emailValid())
        showEmailError(false);
    });
    const filled = () =>
      ["name", "email", "message"].every(
        (name) => form.elements[name].value.trim() !== ""
      ) &&
      emailValid() &&
      form.querySelector('input[name="category"]:checked') !== null &&
      form.elements.agree.checked;
    const update = () => {
      const ready = filled() && verified && !sending;
      button.disabled = !ready;
      if (hint) hint.hidden = ready || sending;
    };
    window.onContactTurnstile = () => {
      verified = true;
      update();
    };
    window.onContactTurnstileExpired = () => {
      verified = false;
      update();
    };
    form.addEventListener("input", update);
    form.addEventListener("change", update);
    form.addEventListener("submit", (event) => {
      if (sending) {
        event.preventDefault();
        return;
      }
      sending = true;
      button.disabled = true;
      button.textContent = "送信中…";
    });
    // 戻るボタンで戻ってきたとき（ページが再利用された場合）に送信中の状態を戻す
    window.addEventListener("pageshow", (event) => {
      if (event.persisted) {
        sending = false;
        button.textContent = "送信する";
        update();
      }
    });
    update();
  })();
</script>
{
  available && (
    <script
      is:inline
      src="https://challenges.cloudflare.com/turnstile/v0/api.js"
      async
      defer
    />
  )
}
