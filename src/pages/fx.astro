---
// ハブページ: FX（見出し・導入文は旧サイトの /fx/ をもとにしている）
import HubPage from "@components/HubPage.astro";
export const prerender = true;
---

<HubPage
  id="fx"
  heading="「FXは怖い」「ハイリスクなイメージがある」と感じていませんか？"
  listHeading="危険じゃない！正しい知識で始めるFX入門の記事"
  description="為替のしくみ、取引の基本ルール、リスク管理の方法など、はじめての方が不安なく FX を始めるための記事をまとめています。"
  points={[
    {
      title: "少ない資金で大きな金額を取引できる",
      text: "預けたお金（証拠金）の最大25倍まで取引できます（個人の場合）。そのぶん損失も大きくなりやすいので、倍率は低めにしましょう。",
    },
    {
      title: "平日はほぼ24時間取引できる",
      text: "世界の市場がつながっているため、仕事のあとの夜の時間でも取引できます。",
    },
    {
      title: "損切りのルールを先に決める",
      text: "「ここまで下がったら手放す」と決めて注文しておくと、損失が大きくなりすぎるのを防げます。",
    },
  ]}
  steps={[
    {
      title: "FX の口座を開く",
      text: "スマホで申し込めます。本人確認書類とマイナンバーを用意しましょう。",
    },
    {
      title: "デモ取引で練習する",
      text: "多くの FX 会社に、お金を使わずに取引を試せるデモ口座があります。まずは操作に慣れましょう。",
    },
    {
      title: "少ない金額・低い倍率で始める",
      text: "1,000通貨単位など小さく取引できる会社を選ぶと、少ない金額から始められます。",
    },
    {
      title: "取引の記録をつける",
      text: "なぜ買ったか・売ったかを記録すると、自分の取引のくせがわかり、改善しやすくなります。",
    },
  ]}
  faqs={[
    {
      question: "FX は危ないのですか？",
      answer:
        "倍率を高くすると、少しの値動きで大きな損失が出ることがあります。倍率を低くし、損切りの注文を入れておけば、リスクを抑えて取引できます。",
    },
    {
      question: "預けたお金以上に損をすることはありますか？",
      answer:
        "相場が急に大きく動いたときなど、まれにあります。多くの FX 会社には、損失が一定を超えると自動で取引を終える仕組み（ロスカット）があります。",
    },
    {
      question: "いくらから始められますか？",
      answer: "1,000通貨単位で取引できる会社なら、数千円から始められます。",
    },
  ]}
>
  <p>
    FX
    は短い期間で大きな利益をねらえる一方で、リスクもあります。はじめての方が不安なく始められるよう、為替のしくみ、取引の基本ルール、そして特に大切なリスク管理の方法を解説した記事をまとめました。
  </p>
  <p>
    デモ取引で試せる知識から、損失を避けるための心構えまで、幅広く取り上げています。
  </p>
</HubPage>
