---
// TOP（仕様: docs/site.md の「TOP」）
import Layout from "@layouts/Layout.astro";
import BlogList from "@components/BlogList.astro";
import HubIcon from "@components/HubIcon.astro";
import { BLOG, CATEGORY, SITE } from "@constants/index.ts";
import { getAllBlogSummaries } from "@libs/microcms.ts";
import { blogPublishedAt } from "@libs/format.ts";
import { siteJsonLd, toJsonLdString } from "@libs/structuredData.ts";
export const prerender = true;

const blogs = await getAllBlogSummaries();
const latest = blogs
  .sort((a, b) => blogPublishedAt(b).localeCompare(blogPublishedAt(a)))
  .slice(0, BLOG.latestCount);

// カテゴリのカードの説明
const hubLeads: Record<(typeof CATEGORY.hubs)[number]["id"], string> = {
  stock: "株・投資信託・NISAのきほん",
  fx: "為替のしくみとリスク管理",
  estate: "少額から始める不動産投資",
  cryptocurrency: "取引所の選び方と注意点",
};

const Meta = { title: SITE.title };
const site = Astro.site ?? new URL(Astro.url.origin);
---

<Layout Meta={Meta} bleed>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      set:html={toJsonLdString(siteJsonLd(site))}
    />
  </Fragment>

  {/* キャッチコピー: 「わかる！」に水色のマーカー */}
  <section class="border-b border-line px-5 pt-10 pb-12">
    <span
      class="inline-block rounded-full bg-primary px-3 py-1 text-xs font-bold text-white"
      >はじめての投資ガイド</span
    >
    <h1 class="mt-5 text-[2rem] leading-tight font-black tracking-tight">
      投資の<br />「わからない」を<br /><span
        class="bg-[linear-gradient(transparent_55%,var(--color-highlight)_55%)]"
        >「わかる！」</span
      >に変える
    </h1>
    <p class="mt-5 text-sm leading-relaxed">
      株式・FX・不動産・暗号資産の始め方や、各サービスの特徴を、はじめての方にもわかる言葉で解説しています。
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href={BLOG.listPath}
        class="rounded-button border-2 border-primary bg-highlight px-6 py-3 text-sm font-bold text-highlight-foreground hover:bg-highlight-hover"
        >記事一覧を見る</a
      >
      <a
        href="#categories"
        class="rounded-button border-2 border-primary bg-background px-6 py-3 text-sm font-bold hover:bg-section"
        >カテゴリから探す</a
      >
    </div>
  </section>

  <div class="space-y-14 px-5 pt-12 pb-14">
    <section id="categories" class="scroll-mt-20 space-y-5">
      <h2 class="text-xl font-black">カテゴリから探す</h2>
      <ul class="grid grid-cols-2 gap-3">
        {
          CATEGORY.hubs.map((hub) => (
            <li>
              <a
                href={`/${hub.id}/`}
                class="flex h-full flex-col rounded-box border-2 border-primary p-4 hover:bg-section"
              >
                <span class="grid size-11 place-items-center rounded-full bg-highlight text-highlight-foreground">
                  <HubIcon id={hub.id} class="size-6" />
                </span>
                <span class="mt-3 font-black">{hub.title}</span>
                <span class="mt-1 text-xs leading-relaxed text-muted-foreground">
                  {hubLeads[hub.id]}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="space-y-4">
      <h2 class="text-xl font-black">新着記事</h2>
      <BlogList blogs={latest} />
      <a
        href={BLOG.listPath}
        class="block rounded-button border-2 border-primary py-3 text-center text-sm font-bold hover:bg-section"
        >記事一覧へ</a
      >
    </section>

    <section class="rounded-box bg-section p-6">
      <h2 class="text-lg font-black">{SITE.title}について</h2>
      <p class="mt-3 text-sm leading-relaxed">
        投資を始めたい方や、忙しい現役世代の方に向けて、投資の情報をわかりやすい言葉でお届けしています。運営者は約9年間、投資を続けてきました。
      </p>
      <a
        href="/operator/"
        class="mt-4 inline-block text-sm font-bold underline hover:text-link-hover"
        >運営者情報 →</a
      >
    </section>
  </div>
</Layout>
