---
// TOP（仕様: docs/site.md の「TOP」）
import Layout from "@layouts/Layout.astro";
import BlogList from "@components/BlogList.astro";
import HubIcon from "@components/HubIcon.astro";
import Faq from "@components/Faq.astro";
import { BLOG, CATEGORY, SITE } from "@constants/index.ts";
import { getAllBlogSummaries } from "@libs/microcms.ts";
import { blogPublishedAt } from "@libs/format.ts";
import { siteJsonLd, toJsonLdString } from "@libs/structuredData.ts";
export const prerender = true;

const blogs = await getAllBlogSummaries();
const latest = blogs
  .sort((a, b) => blogPublishedAt(b).localeCompare(blogPublishedAt(a)))
  .slice(0, BLOG.latestCount);

// カテゴリのカードの説明
const hubLeads: Record<(typeof CATEGORY.hubs)[number]["id"], string> = {
  stock: "株・投資信託・NISAのきほん",
  fx: "為替のしくみとリスク管理",
  estate: "少額から始める不動産投資",
  cryptocurrency: "取引所の選び方と注意点",
};

// よくある質問（画面の表示と構造化データ FAQPage の両方に使う）。ハブページの質問・運営者情報の注意事項と食い違わないようにする
const faqs = [
  {
    question: "投資は何から始めればいいですか？",
    answer:
      "まず生活費の数か月分を預金で確保し、当面使わないお金で始めるのが基本です。はじめての方は、少額から積み立てられる投資信託から始める人が多いです。",
  },
  {
    question: "少ない金額でも投資はできますか？",
    answer:
      "できます。証券会社によっては投資信託を月100円から積み立てられます。不動産クラウドファンディングや暗号資産も、少ない金額から始められるサービスがあります。",
  },
  {
    question: "投資で損をすることはありますか？",
    answer:
      "あります。投資は元本が保証されておらず、買ったときより値下がりすることもあります。余裕のあるお金で、いくつかに分けて長く続けることが大切です。",
  },
  {
    question: "株式・FX・不動産・暗号資産はどう違いますか？",
    answer:
      "株式は会社に、不動産は物件に投資し、FXは通貨の、暗号資産はビットコインなどの値動きで利益をねらいます。値動きの大きさやリスクがちがうので、各カテゴリのページで特徴を確認しましょう。",
  },
  {
    question: "投資の相談はできますか？",
    answer:
      "運営者は金融商品取引業者・投資助言業者ではないため、個別の銘柄や資産運用のご相談にはお答えできません。投資の判断はご自身の責任でお願いします。",
  },
];

const Meta = { title: SITE.title };
const site = Astro.site ?? new URL(Astro.url.origin);
---

<Layout Meta={Meta} bleed>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      set:html={toJsonLdString(siteJsonLd(site))}
    />
  </Fragment>

  {
    /*
      キャッチコピー: 「わかる！」に水色のマーカー
      動き（docs/design.md の「動き」）: 開いたときに見出し → ボタンの順に下からふわっと出し、出たあとにマーカーを左から引く。右上の飾りはゆっくり揺れる
    */
  }
  <section
    class="relative overflow-hidden border-b border-line px-5 pt-10 pb-12"
  >
    {/* 飾り（ロゴの「ン」の水色の四角と斜め線の形） */}
    <div aria-hidden="true" class="pointer-events-none absolute top-8 right-6">
      <span class="float-slow block size-12 rotate-12 rounded-box bg-highlight"
      ></span>
    </div>
    <div
      aria-hidden="true"
      class="pointer-events-none absolute top-28 right-14"
    >
      <span
        class="float-slow-delay block h-7 w-1.5 rotate-[30deg] rounded-full bg-primary"
      ></span>
    </div>
    <span
      class="relative inline-block rounded-full bg-primary px-3 py-1 text-xs font-bold text-white"
      >はじめての投資ガイド</span
    >
    <h1
      data-reveal
      class="relative mt-5 text-[2rem] leading-tight font-black tracking-tight"
    >
      投資の<br />「わからない」を<br /><span class="marker-draw"
        >「わかる！」</span
      >に変える
    </h1>
    <p class="relative mt-5 text-sm leading-relaxed">
      株式・FX・不動産・暗号資産の始め方や、各サービスの特徴を、はじめての方にもわかる言葉で解説しています。
    </p>
    <div data-reveal class="relative mt-8 flex flex-wrap gap-3">
      <a
        href={BLOG.listPath}
        class="group inline-flex items-center gap-2 rounded-button border-2 border-primary bg-highlight px-6 py-3 text-sm font-bold text-highlight-foreground transition-[background-color,scale] hover:bg-highlight-hover active:scale-[0.97] motion-reduce:transition-none"
        >記事一覧を見る<span
          aria-hidden="true"
          class="transition-transform group-hover:translate-x-1 motion-reduce:transition-none"
          >→</span
        ></a
      >
      <a
        href="#categories"
        class="group inline-flex items-center gap-2 rounded-button border-2 border-primary bg-background px-6 py-3 text-sm font-bold transition-[background-color,scale] hover:bg-section active:scale-[0.97] motion-reduce:transition-none"
        >カテゴリから探す<span
          aria-hidden="true"
          class="transition-transform group-hover:translate-y-0.5 motion-reduce:transition-none"
          >↓</span
        ></a
      >
    </div>
  </section>

  <div class="space-y-14 px-5 pt-12 pb-14">
    <section id="categories" class="scroll-mt-20 space-y-5">
      <h2 data-reveal class="text-xl font-black">カテゴリから探す</h2>
      <ul class="grid grid-cols-2 gap-3">
        {
          CATEGORY.hubs.map((hub) => (
            <li>
              {/* ホバーで少し浮き上がり、アイコンの丸が少し大きくなる（影は付けない） */}
              <a
                href={`/${hub.id}/`}
                class="group flex h-full flex-col rounded-box border-2 border-primary p-4 transition-[background-color,translate] duration-300 hover:-translate-y-1 hover:bg-section motion-reduce:transition-none motion-reduce:hover:translate-y-0"
              >
                <span class="grid size-11 place-items-center rounded-full bg-highlight text-highlight-foreground transition-transform duration-300 group-hover:scale-110 group-hover:-rotate-6 motion-reduce:transition-none motion-reduce:group-hover:transform-none">
                  <HubIcon id={hub.id} class="size-6" />
                </span>
                <span class="mt-3 font-black">{hub.title}</span>
                <span class="mt-1 text-xs leading-relaxed text-muted-foreground">
                  {hubLeads[hub.id]}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="space-y-4">
      <h2 data-reveal class="text-xl font-black">新着記事</h2>
      <BlogList blogs={latest} />
      <a
        href={BLOG.listPath}
        class="block rounded-button border-2 border-primary py-3 text-center text-sm font-bold hover:bg-section active:scale-[0.98] motion-reduce:active:scale-100"
        >記事一覧へ</a
      >
    </section>

    <section class="rounded-box bg-section p-6">
      <h2 data-reveal class="text-lg font-black">{SITE.title}について</h2>
      <p class="mt-3 text-sm leading-relaxed">
        投資を始めたい方や、忙しい現役世代の方に向けて、投資の情報をわかりやすい言葉でお届けしています。運営者は約9年間、投資を続けてきました。
      </p>
      <a
        href="/operator/"
        class="group mt-4 inline-block text-sm font-bold underline hover:text-link-hover"
        >運営者情報<span
          aria-hidden="true"
          class="ml-1 inline-block transition-transform group-hover:translate-x-1 motion-reduce:transition-none"
          >→</span
        ></a
      >
    </section>

    <Faq faqs={faqs} />
  </div>
</Layout>
