---
// src/components/Footer.astro
// お問い合わせ・プライバシーポリシーは、ページを作ったらここにリンクを足す（docs/todo.md）
const { title } = Astro.props;
---

<footer class="bg-muted border-t border-line">
  <div
    class="container mx-auto px-4 md:px-6 py-6 flex flex-wrap items-center justify-between gap-x-6 gap-y-3"
  >
    <nav class="flex flex-wrap gap-x-5 gap-y-2 text-sm">
      <a href="/operator/" class="hover:text-link hover:underline">運営者情報</a
      >
    </nav>
    <p class="text-sm text-muted-foreground">
      &copy; {new Date().getFullYear()}
      {title}
    </p>
  </div>
</footer>
