---
// フッター（画面幅いっぱい。黒地に白文字。仕様: docs/design.md の「レイアウト」）
// お問い合わせは、ページを作ったらここにリンクを足す（docs/todo.md）
import Logo from "@components/Logo.astro";
import { BLOG, CATEGORY, SITE } from "@constants/index.ts";

const groups = [
  {
    title: "カテゴリ",
    links: CATEGORY.hubs.map((hub) => ({
      href: `/${hub.id}/`,
      label: hub.title,
    })),
  },
  {
    title: "サイトについて",
    links: [
      { href: BLOG.listPath, label: "記事一覧" },
      { href: "/operator/", label: "運営者情報" },
      { href: "/privacy-policy/", label: "プライバシーポリシー" },
    ],
  },
];
---

<footer class="bg-primary px-5 pt-10 pb-8 text-white lg:px-10 lg:pt-14">
  <div class="lg:flex lg:justify-between lg:gap-10">
    <div>
      <a href="/" class="inline-block"><Logo inverted /></a>
      <p class="mt-3 text-xs leading-relaxed text-white/70">
        {SITE.catchphrase}
      </p>
    </div>
    <nav class="mt-8 grid grid-cols-2 gap-6 lg:mt-0 lg:gap-16">
      {
        groups.map((group) => (
          <div>
            <p class="text-xs font-bold text-white/60">{group.title}</p>
            <ul class="mt-3 space-y-3 text-sm">
              {group.links.map((link) => (
                <li>
                  <a href={link.href} class="hover:underline">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
  </div>
  <p class="mt-10 text-xs text-white/60 lg:mt-14">
    &copy; {new Date().getFullYear()}
    {SITE.title}
  </p>
</footer>
