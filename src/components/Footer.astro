---
// フッター（中央の表示領域の下。黒地に白文字）
// お問い合わせ・プライバシーポリシーは、ページを作ったらここにリンクを足す（docs/todo.md）
import Logo from "@components/Logo.astro";
import { BLOG, CATEGORY, SITE } from "@constants/index.ts";

const links = [
  ...CATEGORY.hubs.map((hub) => ({ href: `/${hub.id}/`, label: hub.title })),
  { href: BLOG.listPath, label: "記事一覧" },
  { href: "/operator/", label: "運営者情報" },
];
---

<footer class="bg-primary px-5 pt-10 pb-8 text-white">
  <a href="/" aria-label="TOP へ"><Logo inverted /></a>
  <p class="mt-3 text-xs leading-relaxed text-white/70">{SITE.catchphrase}</p>
  <nav class="mt-8">
    <ul class="grid grid-cols-2 gap-x-4 gap-y-3 text-sm">
      {
        links.map((link) => (
          <li>
            <a href={link.href} class="hover:underline">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <p class="mt-10 text-xs text-white/60">
    &copy; {new Date().getFullYear()}
    {SITE.title}
  </p>
</footer>
