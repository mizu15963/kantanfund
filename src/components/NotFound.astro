---
// ページが見つからないとき（404）
import { BLOG } from "@constants/index.ts";
---

<div class="py-12 text-center">
  <p class="text-5xl font-bold text-primary">404</p>
  <h1 class="mt-4 text-xl font-bold md:text-2xl">ページが見つかりません</h1>
  <p class="mt-4 text-sm leading-relaxed text-muted-foreground md:text-base">
    お探しのページは、移動または削除された可能性があります。
  </p>
  <div class="mt-8 flex flex-wrap justify-center gap-3">
    <a
      href="/"
      class="rounded-button bg-primary px-5 py-3 text-sm font-bold text-white hover:bg-primary-hover"
      >TOP へ</a
    >
    <a
      href={BLOG.listPath}
      class="rounded-button border border-line px-5 py-3 text-sm font-bold hover:border-primary"
    >
      記事一覧へ
    </a>
  </div>
</div>
