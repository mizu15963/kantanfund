---
// ページ見出し（TOP・記事以外のページの先頭）
// 短い線＋太字の見出し＋（スロットで）説明文。Layout の fullWidth のページで、main の先頭に置く
interface Props {
  // 見出しの文字（見出しに改行の指定などが必要なときは title スロットを使う）
  title?: string;
  // header に足すクラス（例: 下の余白）
  class?: string;
}
const { title, class: className } = Astro.props;
---

<header class:list={["pt-2 md:pt-6", className]}>
  <span class="block h-1 w-10 bg-primary" aria-hidden="true"></span>
  <h1
    class="mt-5 text-[1.4rem] font-bold leading-snug tracking-tight sm:text-3xl md:text-4xl md:leading-tight"
  >
    <slot name="title">{title}</slot>
  </h1>
  <slot />
</header>
