---
// ハブページ（/stock/ /fx/ /estate/ /cryptocurrency/。仕様: docs/site.md の「ハブページ」）
// カテゴリの入口のページ。見出しと導入文は各ページのファイルで渡す（導入文はスロット）。下にそのカテゴリの記事をすべて並べる
import Layout from "@layouts/Layout.astro";
import Breadcrumb from "@components/Breadcrumb.astro";
import BlogList from "@components/BlogList.astro";
import HubIcon from "@components/HubIcon.astro";
import { BLOG, CATEGORY } from "@constants/index.ts";
import { getAllBlogSummaries } from "@libs/microcms.ts";
import { blogPublishedAt } from "@libs/format.ts";

interface Props {
  id: (typeof CATEGORY.hubs)[number]["id"];
  // ページの見出し（h1）
  heading: string;
  // 記事の並びの見出し
  listHeading: string;
  // meta description
  description: string;
}
const { id, heading, listHeading, description } = Astro.props;
const hub = CATEGORY.hubs.find((hub) => hub.id === id)!;
const otherHubs = CATEGORY.hubs.filter((hub) => hub.id !== id);

const blogs = await getAllBlogSummaries({
  filters: `category[contains]${id}`,
});
// 新しい順（移行した記事は旧サイトの公開日で並べる）
blogs.sort((a, b) => blogPublishedAt(b).localeCompare(blogPublishedAt(a)));

const Meta = { title: hub.title, description };
---

<Layout Meta={Meta}>
  <div class="space-y-10">
    <div class="space-y-5">
      <Breadcrumb items={[{ name: "TOP", url: "/" }, { name: hub.title }]} />
      {/* 見出し: 黄色の箱 */}
      <header class="rounded-box bg-highlight p-5 text-highlight-foreground">
        <span
          class="inline-flex items-center gap-2 rounded-full bg-primary px-3 py-1 text-xs font-bold text-white"
        >
          <HubIcon id={id} class="size-4" />
          {hub.title}
        </span>
        <h1 class="mt-4 text-[1.4rem] leading-snug font-black tracking-tight">
          {heading}
        </h1>
      </header>
      <div class="space-y-4 text-[0.95rem] leading-loose">
        <slot />
      </div>
    </div>

    <section class="space-y-4">
      <h2 class="text-xl leading-snug font-black">{listHeading}</h2>
      <BlogList blogs={blogs} />
      <a
        href={`${BLOG.listPath}?category=${id}`}
        class="block rounded-button border-2 border-primary py-3 text-center text-sm font-bold hover:bg-section"
      >
        記事一覧で見る
      </a>
    </section>

    <section class="space-y-4">
      <h2 class="text-lg font-black">ほかのカテゴリ</h2>
      <ul class="flex flex-wrap gap-2">
        {
          otherHubs.map((other) => (
            <li>
              <a
                href={`/${other.id}/`}
                class="inline-flex items-center gap-2 rounded-full border-2 border-primary px-4 py-2 text-sm font-bold hover:bg-section"
              >
                <HubIcon id={other.id} class="size-4" />
                {other.title}
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Layout>
