---
// ロゴ（旧サイトから使い続けるロゴの画像。文字入りなので、サイト名の文字を横に並べない）（docs/design.md の「画像・アイコン」）
// 画像は public/images/logo.png（白い背景用）と logo-white.png（黒い背景用。黒い文字を白にしたもの）。どちらも背景は透明
import { SITE } from "@constants/index.ts";

interface Props {
  // 黒い背景の上に置くとき（フッター）
  inverted?: boolean;
  class?: string;
}
const { inverted = false, class: className } = Astro.props;
---

<img
  src={inverted ? "/images/logo-white.png" : "/images/logo.png"}
  alt={SITE.title}
  width="480"
  height="106"
  class:list={["h-10 w-auto", className]}
/>
