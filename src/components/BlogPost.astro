---
// 記事の本文（仕様: docs/article.md）。見出し・目次・本文の見た目はサイトの決まりに合わせる
import {
  microCMSRichEditorHandler,
  tocExtractor,
  type Transformer,
} from "microcms-rich-editor-handler";
import Date from "@components/Date.astro";
import PromotionNotice from "@components/PromotionNotice.astro";
import { BLOG } from "@constants/index.ts";
import type { Blog } from "@libs/microcms.ts";
import { blogPublishedAt, blogRevisedAt } from "@libs/format.ts";

interface Props {
  blog: Blog;
}
const { blog } = Astro.props;

// microCMS の画像だけ、画面幅に合わせた大きさ・webp で読み込む
// （microCMS 以外の画像はそのまま出す。ライブラリの responsiveImageTransformer は全画像を書き換えるため使わない）
const MICROCMS_IMAGE_HOST = "https://images.microcms-assets.io/";
const IMAGE_WIDTHS = [640, 828, 1200, 1600];
const microcmsImageTransformer: Transformer = ($) => {
  $("img").each((_, img) => {
    const $img = $(img);
    const src = $img.attr("src");
    $img.attr({ loading: "lazy", decoding: "async" });
    if (!src?.startsWith(MICROCMS_IMAGE_HOST) || src.includes("?")) return;
    $img.attr({
      src: `${src}?w=1200&fm=webp`,
      srcset: IMAGE_WIDTHS.map(
        (width) => `${src}?w=${width}&fm=webp ${width}w`
      ).join(", "),
      sizes: "(min-width: 768px) 720px, 100vw",
    });
  });
};

// 目次のリンク先になるよう、id のない見出し（旧サイトから移した本文など）に id を付ける
const headingIdTransformer: Transformer = ($) => {
  $("h2, h3").each((index, heading) => {
    const $heading = $(heading);
    if (!$heading.attr("id")) $heading.attr("id", `heading-${index + 1}`);
  });
};

// 本文の「［広告画像:URL|幅x高さ］」を ASP のバナー画像に戻す（microCMS には外部の画像を入れられないため。docs/article.md の「広告の画像」）
const AD_IMAGE_MARK =
  /［広告画像:(https?:\/\/[^|］\s"<>]+)(?:\|(\d+)x(\d+))?］/g;
const content = (blog.content ?? "").replace(
  AD_IMAGE_MARK,
  (_, src, width, height) =>
    `<img src="${src}" alt=""${width ? ` width="${width}" height="${height}"` : ""} class="ad-image">`
);

const { html, data } = await microCMSRichEditorHandler(content, {
  transformers: [microcmsImageTransformer, headingIdTransformer],
  extractors: {
    toc: [tocExtractor({ ignoreLevels: [1, 4, 5] })],
  },
});
const toc = data.toc;

const publishedAt = blogPublishedAt(blog);
const revisedAt = blogRevisedAt(blog);
// 更新日は公開日と日付が違うときだけ出す
const showRevised = revisedAt.slice(0, 10) !== publishedAt.slice(0, 10);
---

<article>
  {/* 記事の見出し: ページ見出しの形（短い線＋太字）。上に日付とカテゴリ */}
  <header class="pt-2 md:pt-6">
    <span class="block h-1 w-10 bg-primary" aria-hidden="true"></span>
    <p class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm">
      <Date date={publishedAt} />
      {
        showRevised && (
          <span class="text-muted-foreground">
            （更新 <Date date={revisedAt} />）
          </span>
        )
      }
      {
        blog.category?.map((category) => (
          <a
            href={`${BLOG.listPath}?category=${category.id}`}
            class="font-bold text-link hover:underline"
          >
            {category.name}
          </a>
        ))
      }
    </p>
    <h1
      class="mt-3 text-[1.4rem] font-bold leading-snug tracking-tight sm:text-3xl md:leading-snug"
    >
      {blog.title}
    </h1>
  </header>

  <div class="mt-6">
    <PromotionNotice />
  </div>

  {
    blog.thumbnail?.url && (
      <img
        src={`${blog.thumbnail.url}?w=1200&q=75`}
        alt=""
        width={blog.thumbnail.width}
        height={blog.thumbnail.height}
        class="mt-8 h-auto w-full rounded-box"
      />
    )
  }

  {/* 目次: 枠線の箱。見出しの階層は字下げで表す */}
  {
    toc.length > 0 && (
      <nav aria-label="目次" class="mt-8 rounded-box border border-line p-5">
        <p class="text-sm font-bold">目次</p>
        <ul class="mt-3 space-y-2 text-sm">
          {toc.map((item) => (
            <li
              class:list={[
                "border-l-2 border-line pl-3",
                { 3: "ml-4" }[item.level] ?? "",
              ]}
            >
              <a
                href={`#${item.id}`}
                class="block leading-relaxed hover:text-link hover:underline"
              >
                {item.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }

  <div set:html={html} class="entry-content prose mt-8 max-w-none md:mt-10" />
</article>
