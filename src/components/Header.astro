---
// src/components/Header.astro
import { BLOG, CATEGORY } from "@constants/index.ts";

const { title } = Astro.props;

// ロゴ・ナビの形は新デザインで決める（docs/todo.md）
const nav = [
  ...CATEGORY.hubs.map((hub) => ({ href: `/${hub.id}/`, label: hub.title })),
  { href: BLOG.listPath, label: "記事一覧" },
];
---

<header class="bg-background border-b-2 border-primary">
  <div
    class="container mx-auto px-4 md:px-6 py-4 flex flex-wrap items-center justify-between gap-x-3 gap-y-2 sm:gap-x-4"
  >
    <a href="/" class="shrink-0 text-lg font-bold text-primary md:text-xl"
      >{title}</a
    >
    <nav
      class="-mx-4 flex gap-4 overflow-x-auto px-4 whitespace-nowrap [scrollbar-width:none] md:mx-0 md:px-0"
    >
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="text-xs font-medium hover:text-link hover:underline md:text-sm"
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
