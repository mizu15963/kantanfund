---
// ヘッダー（画面幅いっぱい・画面の上に固定。仕様: docs/design.md の「レイアウト」）
// スマホ・タブレット幅: 左にロゴ、右にメニューのボタン（details で開閉する）。PC 幅（lg 以上）: メニューの項目を横に並べる
import Logo from "@components/Logo.astro";
import HubIcon from "@components/HubIcon.astro";
import { BLOG, CATEGORY } from "@constants/index.ts";
---

<header class="sticky top-0 z-20 border-b-2 border-primary bg-background">
  <div class="flex h-14 items-center justify-between px-4 lg:h-16 lg:px-10">
    <a href="/" class="shrink-0"><Logo /></a>

    <nav aria-label="メニュー" class="hidden lg:block">
      <ul class="flex items-center gap-7 text-sm font-bold">
        {
          CATEGORY.hubs.map((hub) => (
            <li>
              <a href={`/${hub.id}/`} class="hover:underline">
                {hub.title}
              </a>
            </li>
          ))
        }
        <li>
          <a
            href={BLOG.listPath}
            class="inline-block rounded-button border-2 border-primary bg-highlight px-5 py-2 text-highlight-foreground hover:bg-highlight-hover"
            >記事一覧</a
          >
        </li>
      </ul>
    </nav>

    <details class="group lg:hidden" data-menu>
      <summary
        class="grid size-10 cursor-pointer list-none place-items-center rounded-full hover:bg-section [&::-webkit-details-marker]:hidden"
        aria-label="メニュー"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          class="size-6"
          aria-hidden="true"
        >
          <path d="M4 7h16M4 12h16M4 17h16" class="group-open:hidden"></path>
          <path d="M6 6l12 12M18 6 6 18" class="hidden group-open:block"></path>
        </svg>
      </summary>
      <nav
        aria-label="メニュー"
        class="absolute inset-x-0 top-full border-b-2 border-primary bg-background"
      >
        <div class="mx-auto max-w-app px-4 pt-2 pb-6">
          <ul class="divide-y divide-line">
            {
              CATEGORY.hubs.map((hub) => (
                <li>
                  <a
                    href={`/${hub.id}/`}
                    class="flex items-center gap-3 py-4 font-bold hover:underline"
                  >
                    <span class="grid size-9 place-items-center rounded-full bg-highlight">
                      <HubIcon id={hub.id} class="size-5" />
                    </span>
                    {hub.title}
                  </a>
                </li>
              ))
            }
          </ul>
          <a
            href={BLOG.listPath}
            class="mt-4 block rounded-button border-2 border-primary bg-highlight py-3 text-center text-sm font-bold text-highlight-foreground hover:bg-highlight-hover"
            >記事一覧を見る</a
          >
        </div>
      </nav>
    </details>
  </div>
</header>

<script>
  // メニューを開いたまま、メニューの外を押したら閉じる
  const menu = document.querySelector<HTMLDetailsElement>("[data-menu]");
  document.addEventListener("click", (event) => {
    if (menu?.open && !menu.contains(event.target as Node)) menu.open = false;
  });
</script>
